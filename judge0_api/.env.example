# Judge0 server connection. Copy this file to .env and fill in local values.
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=replace-with-your-judge0-api-key
JUDGE0_C_LANGUAGE_ID=50

# Per-run sandbox deadlines the wrapper enforces on Judge0 (seconds). These cap
# runaway code such as infinite loops regardless of the Judge0 box's own config.
JUDGE0_CPU_TIME_LIMIT_SECONDS=5
JUDGE0_WALL_TIME_LIMIT_SECONDS=10

# How long a run may wait in Judge0's queue before it starts (seconds). Counted
# separately from the limits above so a busy Judge0 box is not reported as
# student code timing out.
JUDGE0_MAX_QUEUE_WAIT_SECONDS=60
