# Python virtual environment
.venv/
venv/

# Environment variables / secrets
.env

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# PaddleOCR / model cache
.paddleocr/
*.onnx

# Temporary upload files
uploads/*
!uploads/.gitkeep

# Generated/preprocessed OCR output files
outputs/*
!outputs/.gitkeep

# samples/ and datasets/verified/ are tracked — shared ground-truth/training
# data for the team. datasets/recognition/ is NOT: it's fully regenerated
# from those two via evaluators/build_recognition_dataset.py (rerun after any
# retake/relabel), so committing it would just churn binary crops in history
# for something anyone can reproduce with one command.
datasets/recognition/

# Fine-tuned recognizer weights are distributed via a GitHub Release (~76 MB),
# not committed -- they'd bloat the repo and are fully regenerable from
# notebooks/finetune_ppocrv6_rec_colab.ipynb. Keep only the README pointer that
# says where to download them. See models/README.md.
models/*
!models/README.md

# macOS files
.DS_Store