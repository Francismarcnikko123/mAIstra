# Copy to .env (gitignored) and fill in. Never commit real keys.

# Supabase project the OCR server talks to (same URL as the web app).
SUPABASE_URL=
# For now: the web app's publishable key (works while submissions has no RLS).
# Once RLS is on, use a secret key (sb_secret_...) from Jayrald. Never put a
# secret key in the web or mobile app.
SUPABASE_KEY=

# Pre-extraction on arrival (core/auto_extract.py). Off unless "true".
AUTO_EXTRACT=false
AUTO_EXTRACT_INTERVAL_SECONDS=10
# Only papers captured on/after this date are read. Leave empty to start from
# the moment the server starts; set a date to catch up after downtime.
AUTO_EXTRACT_SINCE=

# Who may call this server (main.py). Browsers: the web app's origins,
# comma-separated; empty = localhost/127.0.0.1 on ports 4200 and 4201.
OCR_ALLOWED_ORIGINS=
# Hosts photos may be downloaded from, comma-separated host[:port]; empty =
# the host of SUPABASE_URL above (e.g. add 127.0.0.1:54321 for local Supabase).
OCR_ALLOWED_IMAGE_HOSTS=
